# ==============================================================================
# Adaptive Threat Intelligence - Environment Variables Template
# Copy this file to .env and adjust values for your local environment.
# DO NOT commit real secrets or credentials to source control.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# Central Paths
PROJECT_ROOT=.
DATA_DIR=./data
CONFIG_DIR=./configs
ARTIFACTS_DIR=./artifacts

# Backend Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
API_V1_PREFIX=/api/v1

# Security & Secrets (Placeholders only)
SECRET_KEY=change_this_to_a_secure_random_string_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database Configuration (SQLite default for initial development)
DATABASE_URL=sqlite:///./adaptive_threat_intel.db

# Model Registry & Inference Configuration
ACTIVE_MODEL_VERSION=v1.0.0
DRIFT_DETECTION_WINDOW_SIZE=1000
DRIFT_P_VALUE_THRESHOLD=0.05
UNCERTAINTY_THRESHOLD=0.65

# Frontend Configuration (Next.js public variables)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME=Adaptive Threat Intelligence
NEXT_PUBLIC_APP_VERSION=0.1.0
