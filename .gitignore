# ==============================================================================
# Adaptive Threat Intelligence - .gitignore
# ==============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# C extensions
*.obj
*.o
*.lib

# Distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
/lib/
/lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Environment and secrets
.env
.env.local
.env.*.local
*.env
!.env.example

# Datasets - prevent accidental commits of massive / proprietary network dumps
data/raw/*
!data/raw/.gitkeep
!data/raw/README.md
data/processed/*
!data/processed/.gitkeep
!data/processed/README.md
data/external/*
!data/external/.gitkeep
!data/external/README.md
*.pcap
*.pcapng
*.csv
*.parquet
*.feather
*.h5
*.hdf5

# Machine Learning Artifacts and Binaries
artifacts/models/*
!artifacts/models/.gitkeep
!artifacts/models/README.md
artifacts/metrics/*
!artifacts/metrics/.gitkeep
!artifacts/metrics/README.md
artifacts/reports/*
!artifacts/reports/.gitkeep
!artifacts/reports/README.md
*.pkl
*.pickle
*.joblib
*.onnx
*.pt
*.pth
*.bin
*.model

# Research & Jupyter Notebooks checkpoints
.ipynb_checkpoints
*/.ipynb_checkpoints/*
research/experiments/runs/*
!research/experiments/runs/.gitkeep

# Databases & local storage
*.db
*.sqlite
*.sqlite3
data/*.sqlite3
backend/*.sqlite3

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/

# Node.js and Next.js frontend
node_modules/
frontend/node_modules/
.npm
frontend/.next/
frontend/out/
.next/
out/
.turbo/
frontend/.turbo/
.vercel

# IDE and Editor configurations
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini
